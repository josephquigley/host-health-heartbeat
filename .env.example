# ---- per-category heartbeat ping URLs ----
# Healthchecks.io-style ping URLs (https://<host>/ping/<uuid>).
# One per category; empty disables that category's ping. These are bearer
# tokens — keep the real .env out of git. See DESIGN.md.
#
# Each monitor's Period + Grace MUST match the cadence below that pings it:
#   KERNEL          Period 30 min / Grace 10 min   (matches CRON_KERNEL)
#   SECURITY,REBOOT Period 24 h   / Grace ~3 h      (matches CRON_SECREBOOT)
HC_PING_URL_SECURITY=https://health.example.com/ping/00000000-0000-0000-0000-000000000000
HC_PING_URL_REBOOT=https://health.example.com/ping/00000000-0000-0000-0000-000000000000
HC_PING_URL_KERNEL=https://health.example.com/ping/00000000-0000-0000-0000-000000000000

# ---- cron cadence (optional; the values here are the built-in defaults) ----
# The container renders its crontab from these at start (entrypoint.sh), so you
# can retune cadence with `docker compose up -d` — no image rebuild. Standard
# 5-field cron, UTC. Leaving a var unset uses the default shown.
#
# NEVER use a day-of-month step like `*/2`: busybox crond reads it as EVEN days
# (2,4,6,...) while some heartbeat services read it as ODD days (1,3,5,...), so they
# disagree and the monitor false-alarms DOWN on off-parity days. Use daily/hourly.
# And whenever you change a value, update that category's monitor Period+Grace.
CRON_KERNEL=*/30 * * * *
CRON_SECREBOOT=0 6 * * *
